---
import BaseLayout from '../../layouts/BaseLayout.astro';
const guides=[['Writing a better headline','A headline is a promise. Make it specific enough to trust.','/guides/writing-a-better-headline/'],['From idea to brief','A practical route from a note to a workable brief.','/guides/from-idea-to-brief/'],['A blog structure that helps','Organize around the reader’s decision, not a keyword list.','/guides/blog-structure/'],['YouTube preflight','What to check before the record button.','/guides/youtube-preflight/'],['Thumbnail review','Review the thumbnail at the size people actually see.','/guides/thumbnail-review/'],['Content reuse without repetition','Find the next format in the same idea.','/guides/content-reuse/'],['Internal links with purpose','Connect the next useful question.','/guides/internal-links/'],['A calmer publishing workflow','A five-stage loop for solo creators.','/guides/publishing-workflow/']];
---
<BaseLayout title="Creator Guides"><section class="section shell"><div class="eyebrow">Guides</div><h1>Good process leaves room for good work.</h1><div class="grid">{guides.map(([t,d,h])=><a class="card" href={h}><div class="kicker">GUIDE</div><h3>{t}</h3><p>{d}</p></a>)}</div></section></BaseLayout>
