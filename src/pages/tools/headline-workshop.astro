---
import BaseLayout from '../../../src/layouts/BaseLayout.astro';
---
<BaseLayout title="Headline Workshop"><section class="tool-layout shell"><div><div class="eyebrow">Tool 01</div><h1>Headline Workshop</h1><p class="lede">Make a few honest candidates, then inspect the promise each one makes.</p><p><a href="/guides/writing-a-better-headline/">Read the headline guide →</a></p></div><div class="panel"><div class="form-grid"><label for="topic">Topic<input id="topic" placeholder="e.g. planning a calmer content week"/></label><label for="tone">Tone<select id="tone"><option>Clear and useful</option><option>Curious</option><option>Direct</option></select></label><button class="button alt" id="make">Create candidates</button><div class="panel result" id="result">Your candidates will appear here.</div></div></div></section><script>const topic=document.querySelector<HTMLInputElement>('#topic')!, result=document.querySelector<HTMLDivElement>('#result')!, make=document.querySelector<HTMLButtonElement>('#make')!;make.addEventListener('click',()=>{const t=topic.value.trim()||'your next useful idea';result.textContent=[`A practical guide to ${t}`,`How to make ${t} feel simpler`,`Before you publish: a clearer way to approach ${t}`].join('\n\n')});</script></BaseLayout>
