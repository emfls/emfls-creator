---
import BaseLayout from '../../../src/layouts/BaseLayout.astro';
const items=['The title matches the actual promise','The first screen answers the first question','Links and attribution are checked','Captions / alt text / transcript are ready','Mobile preview has been reviewed','The next action is clear'];
---
<BaseLayout title="Publishing Checklist"><section class="section shell"><div class="eyebrow">Tool 04</div><h1>Publishing Checklist</h1><p class="lede">A quiet final pass. Your checks are saved in this browser only.</p><div class="panel form-grid">{items.map((item,i)=><label><input type="checkbox" data-check={i}/> {item}</label>)}<p id="count" class="kicker">0 / {items.length} checked</p></div></section><script>const boxes=[...document.querySelectorAll<HTMLInputElement>('[data-check]')], count=document.querySelector<HTMLParagraphElement>('#count')!;function update(){const n=boxes.filter(b=>b.checked).length;count.textContent=`${n} / ${boxes.length} checked`;localStorage.setItem('creator-checks',JSON.stringify(boxes.map(b=>b.checked)))}try{JSON.parse(localStorage.getItem('creator-checks')||'[]').forEach((v:boolean,i:number)=>{if(boxes[i])boxes[i].checked=v})}catch{}boxes.forEach(b=>b.addEventListener('change',update));update();</script></BaseLayout>
