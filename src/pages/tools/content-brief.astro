---
import BaseLayout from '../../../src/layouts/BaseLayout.astro';
---
<BaseLayout title="Content Brief Builder"><section class="tool-layout shell"><div><div class="eyebrow">Tool 02</div><h1>Content Brief Builder</h1><p class="lede">Put the audience, intent, questions, and next action on one page.</p></div><div class="panel"><div class="form-grid"><label>Audience<input id="a" placeholder="Who is this for?"/></label><label>Core question<textarea id="q" placeholder="What should they be able to decide or do?"></textarea></label><label>Sections<textarea id="s" placeholder="One section per line"></textarea></label><button class="button alt" id="build">Build brief</button><div class="panel result" id="out">Your brief will appear here.</div></div></div></section><script>const val=(id:string)=>(document.querySelector<HTMLInputElement|HTMLTextAreaElement>(id)?.value||'');const out=document.querySelector<HTMLDivElement>('#out')!;document.querySelector<HTMLButtonElement>('#build')!.addEventListener('click',()=>{out.textContent=`CONTENT BRIEF\n\nAudience: ${val('#a')||'Define the audience'}\nCore question: ${val('#q')||'Define the question'}\nSections:\n${val('#s')||'Add the essential sections'}\n\nNext action: choose one useful action for the reader.`});</script></BaseLayout>
